{
  "name": "agentic-video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "render": "remotion render src/index.ts StudioDemo output/studio-demo/final/studio-demo.mp4",
    "render:still": "remotion still src/index.ts StudioDemo output/studio-demo/final/studio-demo.png --frame=150",
    "brand:preview": "remotion still src/index.ts WorldDirectBrandKit output/brand/world-direct/final/world-direct-ci-kit.png",
    "render:wd-test": "remotion render src/index.ts WorldDirectTest output/world-direct-test/final/world-direct-test.mp4 --codec=h264 --crf=18",
    "still:wd-test": "remotion still src/index.ts WorldDirectTest output/world-direct-test/final/world-direct-test.png --frame=195",
    "render:a1-test": "remotion render src/index.ts A1Test output/a1-test/final/a1-test.mp4 --codec=h264 --crf=18",
    "still:a1-test": "remotion still src/index.ts A1Test output/a1-test/final/a1-test.png --frame=225",
    "prepare:sme-gui": "node scripts/prepare-sme-gui.mjs",
    "render:sme-gui": "remotion render src/index.ts SmeGuiMvp output/sme-gui-mvp/final/sme-gui-mvp-16x9.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=192k --pixel-format=yuv420p",
    "render:sme-gui-v2": "remotion render src/index.ts SmeGuiMvpV2 output/sme-gui-mvp-v2/final/sme-gui-mvp-v2-16x9.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=192k --pixel-format=yuv420p",
    "render:sme-gui-v3": "remotion render src/index.ts SmeGuiMvpV3 output/sme-gui-mvp-v3/final/sme-gui-mvp-v3-16x9.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=192k --pixel-format=yuv420p",
    "render:sme-gui-story": "remotion render src/index.ts SmeGuiStory output/sme-gui-story/final/sme-gui-story-16x9.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=192k --pixel-format=yuv420p",
    "still:sme-gui": "remotion still src/index.ts SmeGuiMvp output/sme-gui-mvp/final/sme-gui-mvp-16x9.png --frame=795",
    "typecheck": "tsc --noEmit",
    "fal": "tsx scripts/fal.ts"
  },
  "dependencies": {
    "@fal-ai/client": "1.10.1",
    "@remotion/fonts": "4.0.527",
    "@remotion/media": "4.0.527",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.527"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.527",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
